# API Keys
CLAUDE_API_KEY=sk-ant-...
ANTHROPIC_API_KEY=sk-ant-...

# Modalita' di classificazione delle notizie:
#   ai        = classifica con Claude (qualita' migliore, consuma crediti)
#   heuristic = classificazione per parole chiave, GRATIS, nessuna chiamata API
#   off       = salva le notizie senza punteggi, classifichi a mano
CLASSIFIER_MODE=ai

# Modello usato in modalita' "ai". Haiku costa molto meno di Sonnet ed e'
# piu' che sufficiente per valutare uno snippet di notizia.
#   claude-haiku-4-5  -> il piu' economico (default)
#   claude-sonnet-5   -> qualita' superiore, costo maggiore
CLAUDE_MODEL=claude-haiku-4-5

# Database
DATABASE_URL=sqlite:///./app.db

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=Customer Intelligence Monitor

# Application
DEBUG=False
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# News Search
NEWS_SEARCH_TIMEOUT=30
NEWS_MAX_RESULTS_PER_COMPANY=10
NEWS_LANGUAGE=it
NEWS_COUNTRY=IT

# Google News RSS (free, no key needed) - best coverage for small/local
# Italian companies, usually the highest hit-rate of all providers
GOOGLE_NEWS_RSS_ENABLED=True

# GDELT (free, no key needed) - broad news coverage
GDELT_ENABLED=True

# GNews.io (https://gnews.io) - used to validate/complement GDELT coverage.
# Free tier: 100 requests/day, dev use only per their ToS. For production
# monitoring of many companies you need a paid plan.
GNEWS_API_KEY=

# RSS / official company press-release feeds (configured via the
# news_sources table / API, see README "Fonti ufficiali (RSS)")
RSS_ENABLED=True

# Hard cap on companies processed per monitoring run (safety limit
# regardless of how many are "due" per the cluster tiering)
MAX_COMPANIES_PER_RUN=200

# Scheduler
SCHEDULER_ENABLED=True
SCHEDULER_CHECK_INTERVAL_HOURS=24

# Default Filters
DEFAULT_COMPANY_TYPE=Cliente
DEFAULT_COMPANY_STATUS=Attiva
MIN_RELEVANCE_SCORE=5

# Dashboard
DASHBOARD_ITEMS_PER_PAGE=20

# Autenticazione (un solo amministratore)
# Non esiste una password predefinita: al primo avvio l'app apre la pagina
# /setup per crearla, e la salva solo come hash. Qui si imposta soltanto il
# nome utente proposto.
AUTH_ENABLED=True
ADMIN_USERNAME=admin
# Durata della sessione in ore
SESSION_TTL_HOURS=12
# Mettere True SOLO se servi l'app in HTTPS: su http://127.0.0.1 il cookie
# "secure" non verrebbe inviato e il login non funzionerebbe.
SESSION_COOKIE_SECURE=False
