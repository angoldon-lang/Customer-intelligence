# API Keys
CLAUDE_API_KEY=sk-ant-...
ANTHROPIC_API_KEY=sk-ant-...

# Database
DATABASE_URL=sqlite:///./app.db

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=Customer Intelligence Monitor

# Application
DEBUG=False
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# News Search
NEWS_SEARCH_TIMEOUT=30
NEWS_MAX_RESULTS_PER_COMPANY=10

# Scheduler
SCHEDULER_ENABLED=True
SCHEDULER_CHECK_INTERVAL_HOURS=24

# Default Filters
DEFAULT_COMPANY_TYPE=Cliente
DEFAULT_COMPANY_STATUS=Attiva
MIN_RELEVANCE_SCORE=5

# Dashboard
DASHBOARD_ITEMS_PER_PAGE=20
